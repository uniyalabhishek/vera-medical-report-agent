# Required for live, synthetic/de-identified document analysis.
OPENAI_API_KEY=
SARVAM_API_KEY=

# Required on Vercel for durable workflow state and private report files.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Required for a protected production MVP. Browser username: vera.
MVP_ACCESS_CODE=

# Optional local development data path.
VERA_DATA_DIR=

# Optional model overrides. Defaults match the approved MVP architecture.
OPENAI_EXTRACTION_MODEL=gpt-5.6-terra
OPENAI_SYNTHESIS_MODEL=gpt-5.6-sol
OPENAI_QUESTION_MODEL=gpt-5.6-terra
